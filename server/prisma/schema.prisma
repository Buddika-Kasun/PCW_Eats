generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Item {
  id        String  @id
  code      String
  name      String
  uom       String
  price     Float
  category  String? @default("stock-keeping")
  shelfLife String? @default("perpetual") @map("shelf_life")

  active    Boolean @default(true)

  createdBy String? @map("created_by")
  updatedBy String? @map("updated_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")
  
  @@map("items")
}

model Meal {
  id           String @id
  code         String
  name         String
  cost         Float
  eligibleFrom String @map("eligible_from")
  eligibleTo   String @map("eligible_to")

  active    Boolean @default(true)

  createdBy String? @map("created_by")
  updatedBy String? @map("updated_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")
  
  @@map("meals")
}

model Quota {
  id        String @id
  code      String
  itemsJson String @map("items_json") @db.Text

  active    Boolean @default(true)

  createdBy String? @map("created_by")
  updatedBy String? @map("updated_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@map("quotas")
}

model DepartmentQuotaMap {
  id            String @id
  department    String
  effectiveFrom String @map("effective_from")
  quotaId       String @map("quota_id")

  active    Boolean @default(true)

  createdBy String? @map("created_by")
  updatedBy String? @map("updated_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@map("dept_quota_maps")
}

model Canteen {
  id   String @id
  code String
  name String
  type String

  active    Boolean @default(true)

  createdBy String? @map("created_by")
  updatedBy String? @map("updated_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")
  
  @@map("canteens")
}

model Inventory {
  id       String @id
  itemId   String @map("item_id")
  item     String
  uom      String
  stock    Float
  minLevel Float  @map("min_level")
  status   String
  
  active    Boolean @default(true)

  @@map("inventory")
}

model DailyBatch {
  id           String  @id
  itemId       String  @map("item_id")
  itemName     String  @map("item_name")
  date         String
  deliveryTime String? @map("delivery_time")
  receivedQty  Float   @map("received_qty")
  issuedQty    Float   @map("issued_qty")
  remainingQty Float   @map("remaining_qty")
  unitPrice    Float   @map("unit_price")
  status       String
  clearedAt    String? @map("cleared_at")
  wasteQty     Float?  @map("waste_qty")

  active    Boolean @default(true)

  @@map("daily_batches")
}

model User {
  id                  String  @id
  name                String
  dept                String
  role                String
  fingerprintEnrolled Boolean? @map("fingerprint_enrolled")
  biometricCardNo     String?  @map("biometric_card_no")

  active    Boolean @default(true)

  @@map("users")
}

model Transaction {
  id        String  @id
  date      String
  time      String?
  departmentId String? @map("department_id")
  dept      String
  item      String
  qty       Float
  cost      Float
  type      String
  category  String?
  userId    String? @map("user_id")
  userName  String? @map("user_name")
  canteenId String? @map("canteen_id")

  active    Boolean @default(true)

  @@map("transactions")
}

model DeptBalance {
  department String @id
  value      String @db.Text

  @@map("dept_balances")
}

model BiometricLog {
  id               String @id
  employeeNo       String @map("employee_no")
  employeeName     String @map("employee_name")
  department       String
  timestamp        String
  deviceId         String @map("device_id")
  deviceIp         String @map("device_ip")
  verificationMode String @map("verification_mode")
  status           String

  @@map("biometric_logs")
}

// ---------------------------------------------------------------------------
// Special Orders
// ---------------------------------------------------------------------------

model SpecialOrder {
  id            String  @id
  orderNo       String  @unique @map("order_no")  // e.g. "O20261126001"
  requesterId   String  @map("requester_id")      // PCW Ride user id
  requesterName String  @map("requester_name")
  departmentId  String  @map("department_id")
  departmentName String @map("department_name")
  mealId        String  @map("meal_id")
  mealName      String  @map("meal_name")
  count         Int
  releasedCount   Int    @default(0) @map("released_count")
  purpose       String  @db.Text
  guestRangeStart String? @map("guest_range_start")  // e.g. "S1001"
  guestRangeEnd   String? @map("guest_range_end")    // e.g. "S1003"

  active    Boolean  @default(true)

  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  guests    SpecialOrderGuest[]

  @@map("special_orders")
}

model SpecialOrderGuest {
  id        String  @id              // e.g. "S1001"
  orderId   String  @map("order_id") // FK to SpecialOrder.id
  active    Boolean @default(true)

  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  order     SpecialOrder @relation(fields: [orderId], references: [id])

  @@map("special_order_guests")
}

